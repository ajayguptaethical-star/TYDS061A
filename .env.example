# EduQuestion AI - Environment Variables

# AI Provider Configuration
# Set your Google Gemini API key or OpenAI API Key below
GEMINI_API_KEY=
AI_API_KEY=
OPENAI_API_KEY=

# Preferred AI Provider ("gemini", "openai", or "fallback")
AI_PROVIDER=gemini

# Models
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Maximum PDF upload limit in megabytes
MAX_PDF_SIZE_MB=5
